#!/usr/bin/env bash
# Pre-push gate: the two checks a contributor can actually fail.
#
#   pnpm typecheck:strict   tsc --noEmit --strict
#   pnpm lint:strict        eslint . --max-warnings 0
#
# Bypass (use sparingly — emergency hotfix only):
#   SKIP_PRE_PUSH=1 git push
#
# Disable globally for one session (e.g., docs-only stretch of work):
#   git push --no-verify
#
# WHY NOT `next build` ANY MORE?
# It used to run one, on the reasoning that it caught strict ESLint and
# production type narrowing that `tsc --noEmit` did not. That gap is closed:
# this hook now runs the strict type-check and the strict lint directly, so it
# checks MORE than the build did, not less — `next build` ran neither in strict
# mode.
#
# The build was also costing what it could not pay for. next.config.ts now sets
# typescript.ignoreBuildErrors and eslint.ignoreDuringBuilds, because the
# build-time type-check was 1.6 GB of peak memory and it ran the 8 GB Vercel
# container out of RAM (exit 137, SIGKILL) on 2026-09-13. A build here would
# therefore no longer check types at all — it would be 80 seconds proving
# nothing this hook has not already proven.
#
# CI still builds every pull request, so a build failure is caught before merge
# rather than before push.

set -euo pipefail

if [ "${SKIP_PRE_PUSH:-}" = "1" ]; then
  printf "\033[33m⚠️  pre-push: skipped via SKIP_PRE_PUSH=1\033[0m\n"
  exit 0
fi

# Skip when nothing checkable changed. Pulls the diff between local HEAD and
# the remote ref being pushed.
remote="$1"
url="$2"

# Read the refs being pushed from stdin.
# Format per push: <local-ref> <local-sha> <remote-ref> <remote-sha>
# A zero remote-sha means the remote branch doesn't exist yet (first push).
zero='0000000000000000000000000000000000000000'
needs_check=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # If we're deleting a remote branch, skip
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  # If the remote ref doesn't exist yet, check everything (first push)
  if [ "$remote_sha" = "$zero" ]; then
    needs_check=1
    break
  fi

  # Diff the range remote_sha..local_sha — if it touches build-relevant files, build
  if git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null \
    | grep -qE '\.(ts|tsx|js|jsx|mjs|cjs|css|json|prisma)$|^next\.config|^tsconfig|^package(\.|-lock\.)'; then
    needs_check=1
    break
  fi
done

if [ "$needs_check" -eq 0 ]; then
  printf "\033[32m✓\033[0m pre-push: no checkable files changed — skipping.\n"
  exit 0
fi

printf "\033[36m🔨 pre-push: strict type-check and strict lint…\033[0m\n"
printf "   (Bypass with SKIP_PRE_PUSH=1 git push if truly needed.)\n\n"

start=$(date +%s)

# prisma generate first: both checks read the generated client's types, and on a
# fresh clone or after a schema change it does not exist yet. Without this the
# hook would reject a perfectly good push with hundreds of phantom type errors.
if ! npx prisma generate >/dev/null 2>&1; then
  printf "\n\033[31m✗\033[0m pre-push: 'prisma generate' failed — push REJECTED.\n"
  exit 1
fi

# Drop generated route types first. tsconfig.json includes `.next/types/**/*.ts`,
# which `next build` writes — so a type-check run outside a build reads whatever
# a PREVIOUS build left there. On a branch that removed or renamed a route, that
# stale validator references a deleted file and the hook rejects a perfectly good
# push with phantom TS2307s. Deleting them makes this gate depend on the working
# tree and nothing else.
#
# What that gives up: Next's generated route-type validation, which only a real
# build can produce. CI runs `pnpm build` on every pull request, so it is checked
# before merge — just not before push. `next dev` and `next build` regenerate
# these immediately.
rm -rf .next/types .next/dev/types

# Run through the package scripts, NOT a hand-rolled tsc/eslint invocation, so
# the hook cannot drift from what CI runs. typecheck:strict carries
# NODE_OPTIONS=--max-old-space-size=4096 for exactly the reason CONTRIBUTING
# records: without it the checker exhausts the default heap, aborts, and a
# crashed run looks identical to a clean one. Reproducing that flag by hand here
# is the drift this avoids.
#
# SKIP_NODE_VERSION_CHECK=1 because both scripts carry a `pre` step pinning Node
# to an exact PATCH version, and a contributor one patch release ahead would be
# unable to push at all. The previous hook reached for `npx` to dodge the same
# guard; this says so out loud instead. The guard still fires on every direct
# `pnpm typecheck:strict`, `pnpm lint:strict` and `pnpm build`, and in CI — which
# re-runs both scripts authoritatively on the pinned version anyway.
#
# Each is run unpiped and its exit code tested directly: CONTRIBUTING records
# how piping through grep once hid a crashed type-check for an unknown period.
export SKIP_NODE_VERSION_CHECK=1

if ! pnpm typecheck:strict; then
  end=$(date +%s)
  printf "\n\033[31m✗\033[0m pre-push: 'pnpm typecheck:strict' failed in $((end-start))s — push REJECTED.\n"
  printf "   CI runs the same script and would reject this too. Fix locally first.\n"
  printf "   Emergency bypass (NOT recommended): SKIP_PRE_PUSH=1 git push\n"
  exit 1
fi

if ! pnpm lint:strict; then
  end=$(date +%s)
  printf "\n\033[31m✗\033[0m pre-push: 'pnpm lint:strict' failed in $((end-start))s — push REJECTED.\n"
  printf "   CI runs the same script and would reject this too. Fix locally first.\n"
  printf "   Emergency bypass (NOT recommended): SKIP_PRE_PUSH=1 git push\n"
  exit 1
fi

end=$(date +%s)
printf "\n\033[32m✓\033[0m pre-push: type-check and lint passed in $((end-start))s — pushing.\n"
exit 0
