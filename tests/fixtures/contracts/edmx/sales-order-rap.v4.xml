        <Annotation Term="SAP__capabilities.TopSupported" Bool="true"/>
        <Annotation Term="SAP__capabilities.SkipSupported" Bool="true"/>
        <Annotation Term="SAP__capabilities.CountRestrictions">
          <Record>
            <PropertyValue Property="Countable" Bool="true"/>
          </Record>
        </Annotation>
        <Annotation Term="SAP__capabilities.SelectSupport">
          <Record>
            <PropertyValue Property="Supported" Bool="true"/>
          </Record>
        </Annotation>
      </Annotations>
      <Annotations Target="SAP__self.Container/Customer">
        <Annotation Term="SAP__capabilities.InsertRestrictions">
          <Record>
            <PropertyValue Property="Insertable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="SAP__capabilities.UpdateRestrictions">
          <Record>
            <PropertyValue Property="Updatable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="SAP__capabilities.DeleteRestrictions">
          <Record>
            <PropertyValue Property="Deletable" Bool="false"/>
          </Record>
        </Annotation>
