# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
tests/e2e/.auth-state*.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temporary and Large Files
all_routes.txt
all_navigation_calls.txt
prisma/dev.db
*.zip
*.gz
*.png
# Served assets are source, not generated output.
#
# `*.png` above exists to keep screenshots and generated reports out of the
# repository. It also swallows anything under public/, which is the one place a
# PNG is a shipped artefact rather than a by-product — the app requests these by
# URL at runtime.
#
# This is the same shape as the `*.html` incident recorded below: the file was on
# disk, `git add` reported success, the build passed, and the asset was absent
# from the repository. Here it would have shipped five broken images to
# production with nothing failing locally.
#
# `**` because an asset filed one folder deeper must not fall back out of scope.
!public/**/*.png
*.html
# Design contracts are source-of-truth, not generated reports.
#
# `*.html` above exists to keep generated reports out. It also silently swallowed
# the CoreEdge design contracts when they were committed into a nested folder:
# the negation below was one level deep, the pack lives two, and `git add` on the
# directory reported success while dropping every .html in it. The visual
# contract the Build Bible's §0 gate refers to was absent from the repository
# while appearing to have been committed.
#
# `**` so a design contract cannot go missing again by being filed one folder
# deeper than the rule anticipated.
!docs/neutral-discovery/design/*.html
!docs/coreedge/**/*.html
*.docx
*.xlsx
*.xlsm
.env*.local

# Design package — allow committed mocks (HTML, PNG, JPG, JSX) under docs/design/
!docs/design/**

# Visual-regression baselines — pinned screenshots that fail CI on drift
!tests/visual-regression/**
!tests/visual-regression-app/**

# Playwright reports / artifacts — local-only, never tracked
playwright-report/
playwright-visual-report/
playwright-visual-app-report/
test-results/

# Phase 13.6 — user-supplied SAP API Hub export (ignore contents, not the dir,
# so the illustrative demo seed below can be re-included).
/sap-references/*
# …but ship the illustrative demo seed for the Capability Catalogue
!/sap-references/hub-content-seed.json
# The harvested Hub catalogue IS committed, deliberately.
#
# `/sap-references/*` exists to keep large downloaded exports out. This file is
# not downloaded — it is produced by scripts/harvest-sap-api-hub.ts against a
# public endpoint, and it carries its own provenance block (source, method,
# harvestedAt, counts, and completeness: "floor").
#
# Committing it is the fix for a real gap: nothing recorded WHICH Hub snapshot
# produced the catalogue rows or WHEN, so "is the catalogue current?" could only
# be answered from memory. A gitignored input makes an import unreproducible and
# unreviewable; 2.2MB of JSON is a small price for both.
!/sap-references/api-hub-catalog.json
# …and the artifact COUNTS, for the same reason and by the same route.
#
# CDS views and BAdIs number ~13,000 Hub-wide: too many to commit as rows for
# content nothing probes, and previously represented only by illustrative seed
# numbers (4,513 / 1,665) that no measurement supported. This file is the
# measurement — counts per package product tag, same anonymous harvest, same
# provenance block, ~2KB. A test computes the per-edition split from it using
# the real tag classifier.
!/sap-references/hub-artifact-counts.json
# …and the per-type drop targets + README (committed, bundled into the admin
# Rebuild endpoint). Real exports are dropped INTO these files, not new paths.
!/sap-references/hub-content/
/api-hub-catalog.json
.vercel-token
.claude/

# curation-model derived files (regenerated from inputs)
curation-model/_*.txt
curation-model/_*.tsv
