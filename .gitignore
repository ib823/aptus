# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
tests/e2e/.auth-state*.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temporary and Large Files
all_routes.txt
all_navigation_calls.txt
prisma/dev.db
*.zip
*.gz
*.png
*.html
*.docx
*.xlsx
*.xlsm
.env*.local

# Design package — allow committed mocks (HTML, PNG, JPG, JSX) under docs/design/
!docs/design/**

# Visual-regression baselines — pinned screenshots that fail CI on drift
!tests/visual-regression/**

# Playwright reports / artifacts — local-only, never tracked
playwright-report/
playwright-visual-report/
test-results/
