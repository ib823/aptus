{
  "rules": {
    "declaration-property-value-disallowed-list": {
      "/^grid-template-columns$/": [
        "/^\\d+px(\\s+\\d+px)+$/"
      ],
      "/^width$/": [
        "/^\\d{4,}px$/"
      ]
    }
  },
  "ignoreFiles": [
    "node_modules/**",
    ".next/**",
    "dist/**",
    "**/*.{ts,tsx,js,jsx,json,md}"
  ]
}
