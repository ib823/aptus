{
  "name": "abeam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:node-version": "node scripts/check-node-version.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "predev": "node scripts/check-node-version.mjs",
    "prebuild": "node scripts/check-node-version.mjs",
    "prestart": "node scripts/check-node-version.mjs",
    "pretest": "node scripts/check-node-version.mjs",
    "prelint:strict": "node scripts/check-node-version.mjs",
    "pretypecheck:strict": "node scripts/check-node-version.mjs",
    "predb:push": "node scripts/check-node-version.mjs",
    "predb:generate": "node scripts/check-node-version.mjs",
    "predb:seed": "node scripts/check-node-version.mjs",
    "dev": "next dev -p 3003",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/check-production-env.js && node scripts/migrate-deploy-with-retry.mjs && prisma generate && next build",
    "prebuild:production": "node scripts/check-production-env.js",
    "start": "next start -p 3003",
    "lint": "eslint",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck:strict": "tsc --noEmit --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=unauthenticated --project=authenticated --project=admin --project=consultant --project=process-owner --project=it-lead --project=executive --project=journeys --project=edge-cases --project=responsive-views",
    "test:e2e:mobile": "playwright test --project=responsive-views",
    "test:e2e:journeys": "playwright test --project=journeys",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test tests/e2e/login.unauth.spec.ts tests/e2e/portal.auth.spec.ts tests/e2e/accessibility.unauth.spec.ts tests/e2e/accessibility.auth.spec.ts --project=unauthenticated --project=authenticated",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual-app": "playwright test --config=playwright.visual-app.config.ts",
    "test:visual-app:update": "playwright test --config=playwright.visual-app.config.ts --update-snapshots",
    "test:security": "vitest run tests/security",
    "test:perf": "vitest run tests/performance",
    "test:a11y": "playwright test tests/e2e/accessibility.unauth.spec.ts tests/e2e/accessibility.auth.spec.ts --project=unauthenticated --project=authenticated",
    "test:ci": "vitest run && pnpm test:e2e:chromium",
    "test:full": "vitest run && playwright test",
    "test:coverage": "vitest run --coverage",
    "verify:data": "tsx scripts/verify-data.ts",
    "sap:tdd:smoke": "tsx scripts/smoke-s4-public-api.ts",
    "sap:tdd:inspect": "tsx scripts/inspect-s4-public-service.ts",
    "ingest": "tsx scripts/ingest-sap-zip.ts",
    "catalog:snapshot": "tsx scripts/snapshot-catalog.ts",
    "fixtures:classifier:refresh": "tsx scripts/snapshot-classifier-fixture.ts",
    "migrate:blobs": "tsx scripts/migrate-blobs-to-vercel.ts",
    "migrate:roles": "tsx scripts/migrate-roles.ts",
    "migrate:statuses": "tsx scripts/migrate-statuses.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --port 5556",
    "postinstall": "prisma generate",
    "prepare": "bash scripts/install-githooks.sh",
    "hooks:install": "bash scripts/install-githooks.sh",
    "feat:new": "bash scripts/new-feature.sh"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@sentry/nextjs": "^10.42.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.3",
    "@sparticuz/chromium": "^148.0.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.4",
    "@vercel/blob": "^2.3.1",
    "adm-zip": "^0.5.16",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "exceljs": "^4.4.0",
    "geist": "^1.7.0",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "next": "15.5.18",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "otpauth": "^9.5.0",
    "prisma": "^6.19.2",
    "puppeteer-core": "^25.0.4",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "15.5.18",
    "jsdom": "^28.1.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "core-js",
      "sharp",
      "esbuild",
      "@esbuild/linux-x64",
      "msw"
    ],
    "overrides": {
      "@xmldom/xmldom": ">=0.8.12",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "fast-uri": ">=3.1.1",
      "picomatch": ">=4.0.4",
      "postcss@<8.5.10": "8.5.15",
      "dompurify@<3.4.0": "3.4.5",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=4.0.0 <5.0.6": "5.0.6",
      "@vercel/blob>undici": ">=7.24.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "nodemailer": "8"
      }
    }
  },
  "volta": {
    "node": "22.22.1",
    "pnpm": "10.23.0"
  }
}
