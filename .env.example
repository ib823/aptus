# Database
# For Vercel serverless: append ?connection_limit=5&pool_timeout=10 to avoid
# exhausting DB connections across concurrent function invocations.
#
# Behind a transaction-mode pooler (P0.19, docs/runbooks/coreedge-db-budget.md):
#   DATABASE_URL         the POOLED endpoint (Neon: the "-pooler" host), with
#                        ?pgbouncer=true&connection_limit=5&pool_timeout=10
#   DIRECT_DATABASE_URL  the DIRECT endpoint. `prisma migrate deploy` uses it
#                        (schema.prisma directUrl): Prisma Migrate takes a
#                        session advisory lock, which a pooler cannot hold.
# The code needs no database session (tests/unit/db/pooler-compatibility.test.ts),
# and in the steady state a governed read sends at most 4 statements and a
# write 5; occasional bookkeeping (hourly, once per instance) can add a few,
# as src/lib/governed/db-budget.ts lists. Locally both point at the same database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fit_portal"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fit_portal"
# The load test (pnpm coreedge:load-test) reads ONLY this, never DATABASE_URL;
# it seeds and deletes its own organisation. Point it at a scratch database.
# LOAD_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fit_portal_loadtest"

# Vercel Blob (binary file storage — create store at https://vercel.com/dashboard/stores)
BLOB_READ_WRITE_TOKEN=""

# Auth
NEXTAUTH_SECRET="generate-a-random-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3003"

# Brevo SMTP (https://app.brevo.com/settings/keys/smtp)
# Port 465 is implicit TLS (TLS from the first byte). Every other port starts
# in plain text and MUST upgrade with STARTTLS before credentials are sent.
# SMTP_SECURE=true asks for implicit TLS on another port; SMTP_REQUIRE_TLS=false
# allows a plain-text relay (a local catcher such as MailHog on 1025) — never
# on a real deployment. See docs/runbooks/developer-onboarding.md.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=""
SMTP_REQUIRE_TLS=""
SMTP_USER="your-brevo-smtp-login"
SMTP_PASS="your-brevo-smtp-password"
EMAIL_FROM="your-verified-sender@example.com"
EMAIL_SENDER_NAME="ABeam"
# NextAuth EmailProvider connection URL — alternative to SMTP_HOST/PORT/USER/PASS.
# When set, NextAuth will use this single URL to send magic-link emails. Format:
#   smtp://user:pass@host:port
# Leave blank to use the SMTP_* values above.
EMAIL_SERVER=""

# WebAuthn (optional)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="ABeam"
WEBAUTHN_ORIGIN="http://localhost:3003"

# Passkey step-up on governance actions: off | warn | enforce. Optional; defaults to warn.
#
# Governance actions are deciding or revoking a grant; issuing, rotating or
# revoking a runtime credential or write key; sending a claim link; saving a
# connection's secrets or turning on its writes. They need a passkey assertion
# made on this session in the last 5 minutes. Adding a passkey beside an
# existing one, and removing one, are gated the same way; a first passkey is
# not (nothing to assert with), and every passkey added is audited and emailed.
# So are an admin creating an account whose role can act on governance,
# changing anyone's role, and resetting someone's passkeys (/api/admin/users).
#   enforce — refused (403 STEP_UP_REQUIRED) until the person confirms with
#             their passkey; the console asks and retries.
#   warn    — allowed, and each one is recorded as a STEP_UP_MISSING audit row
#             filed under the row acted on (PlatformAudit for an actor with no
#             organization); a banner asks approvers to add or use a passkey.
#   off     — not checked or recorded (escape hatch).
# Personal and CI tokens, and any caller that does not say it is a session, are
# refused in every mode. An unrecognised value reads as warn. Settle
# WEBAUTHN_RP_ID before enforcing: a passkey only works on the host it was
# registered on. See docs/runbooks/coreedge-step-up.md.
COREEDGE_STEP_UP=""

# Access grants bound to one interface: legacy | strict. Optional; defaults to legacy.
#
# Every grant now names the ONE interface, and SAP product, it was approved for,
# and the broker serves a bound grant for that interface only. Grants approved
# before this release were bound by the migration to the single interface they
# match; one that matches none or several stays unbound and is flagged for
# re-approval (Control Tower grants, CoreEdge requests board).
#   legacy — an unbound grant keeps the old matching (service id + operation +
#            environment) on the interfaces that existed at the deploy, and
#            every call it authorises stamps unboundLastUsedAt (at most hourly
#            per grant). Nothing that worked before stops. An interface added
#            after the deploy needs a bound grant in either mode.
#   strict — an unbound grant authorises nothing: 403 FORBIDDEN, with a message
#            asking for the grant to be approved again against the interface.
# Switch to strict once `pnpm grants:binding --check` exits 0 (no live unbound
# grant). An unrecognised value reads as legacy. See
# docs/runbooks/coreedge-grant-binding.md.
COREEDGE_GRANT_BINDING=""

# Runtime key hygiene (P0.11). All optional; the defaults are the policy.
# See docs/runbooks/coreedge-credential-hygiene.md.
#
# COREEDGE_KEY_EXPIRY: enforce | off. Defaults to enforce.
#   enforce — every TEST or PROD key minted from now on carries an expiry, at
#             most COREEDGE_KEY_MAX_TTL_DAYS ahead: a PROD issue without one is
#             400, a TEST one gets the default, a rotation or claim gets a fresh
#             default lifetime, and no write key is sealed onto a TEST or PROD
#             key without one. Checked only when a key is MINTED: no existing
#             key, and no running integration, is affected.
#   off     — the old behaviour (any expiry or none). The rollback lever.
# An unrecognised value reads as enforce.
COREEDGE_KEY_EXPIRY=""
# The longest a TEST or PROD key may live, in days (1-365). Defaults to 90.
COREEDGE_KEY_MAX_TTL_DAYS=""
# The lifetime a TEST or PROD key gets when nobody chose one, in days (1-365,
# never more than the maximum). Defaults to 90.
COREEDGE_KEY_DEFAULT_TTL_DAYS=""
# How long a key replaced by a rotation keeps working, in hours (0-168).
# Defaults to 24. 0 cuts over at once, as rotation did before P0.11.
COREEDGE_KEY_ROTATION_OVERLAP_HOURS=""

# Time-to-first-call milestones (P2.12): on | off. Optional; defaults to on.
#   on  — the first occurrence of each milestone (workspace sign-up, first
#         interface, grant requested/decided, first key, connection saved and
#         first good probe, first successful call per app and environment) is
#         written to DeveloperJourneyEvent, after the action and unable to fail
#         it. The broker writes its first call at most once per app and
#         environment per instance, never on every call.
#   off — nothing is written; the tiles keep showing what was recorded.
# Only the exact word "off" stops recording. A measurement, not a control:
# neither value changes what any user may do. See
# docs/runbooks/coreedge-time-to-first-call.md.
COREEDGE_JOURNEY_EVENTS=""

# The governed pipeline's circuit breaker (P0.14): observe | enforce | off.
# Optional; defaults to observe.
#
# One circuit per SAP system (per stored connection). A Workbench preview
# counts into a console circuit of its own, per organization and system, so a
# builder's previews never refuse production calls or another organization's
# previews, and SAP's 4xx answer to a preview's query counts for nothing.
# Five consecutive failures (timeouts, 5xx, an unreachable host) open it for
# 30 seconds, then one call is let through to probe it. SAP refusing a call
# (401, 403, 404, 422) is a healthy answer and counts for nothing, and so is
# any status SAP answers a write's POST with (the payload is the caller's, and
# the connection's circuit is every solution's): a write counts only when SAP
# did not answer it. Shared
# across instances through UPSTASH_REDIS_REST_URL and _TOKEN when set;
# otherwise each instance keeps its own. Cost per governed call: two Redis
# reads, plus a compare-and-set only when the circuit changes (a failure, an
# open, a close, a probe).
#   observe — counted and logged ("[circuit] would refuse"), never refused.
#             Every call that works today keeps working. A call it would have
#             refused goes ahead but is not counted, so the log lines match
#             what enforce would refuse.
#   enforce — an open circuit refuses the call before anything is sent to SAP:
#             503 CIRCUIT_OPEN with Retry-After, audited with failureReason
#             CIRCUIT_OPEN (left out of the upstream-errors incident). A write
#             refused this way releases its Idempotency-Key.
#   off     — not consulted at all.
# An unrecognised value reads as observe. A breaker store that errors, or
# does not answer within 400 ms, never refuses or holds a call. Switch to enforce only as described in
# docs/runbooks/coreedge-circuit-breaker.md.
COREEDGE_CIRCUIT_BREAKER=""

# The governed query surface on /data (P1.4): on | off. Optional; defaults to
# off. With it on, a read may carry select, filter.<Field>.<op>, orderby,
# key.<Field>, count, pageSize and cursor, within the interface's query
# policy (Studio). With it off, a read carrying any of those names is REFUSED
# (400 VALIDATION_ERROR, error.query.rule NOT_ENABLED), never served with the
# names ignored: a filter that is ignored serves every row. Only an exact "on"
# switches it on. ?limit reads are the same either way.
# docs/runbooks/coreedge-query-surface.md.
COREEDGE_QUERY_SURFACE=""

# CoreEdge's own token keys (P1.4): paging cursors are sealed under them and
# the audit's query hash is keyed by them. Required once
# COREEDGE_QUERY_SURFACE=on, on every deployment type (the build fails
# without them); not read while it is off.
#   COREEDGE_TOKEN_KEYS        "t1:<64 hex>,t2:<64 hex>" — generate each key
#                              with `openssl rand -hex 32`. Never reuse
#                              NEXTAUTH_SECRET or a SAP connection key.
#   COREEDGE_TOKEN_ACTIVE_KEY  the label new cursors are sealed under.
# Rotate by adding t(n+1) and deploying, making it active and deploying, and
# removing the old key two hours later (a paging run's lifetime). Without
# them, development and test derive a key from NEXTAUTH_SECRET; production
# and previews never do.
COREEDGE_TOKEN_KEYS=""
COREEDGE_TOKEN_ACTIVE_KEY=""

# Check a re-saved SAP connection secret against SAP before it is stored
# (P0.14): observe | enforce | off. Optional; defaults to observe.
#   The probe runs when a save re-saves an ACTIVE connection whose stored
#   secret works by the record (its last Test or nightly probe was OK, or a
#   lane proved a read through it within 24 hours) with CHANGED sign-in
#   credentials on the same system (host and base path, environment, SAP
#   client). It sends the new credentials to SAP once, with nothing written:
#   the sign-in and the probe path's $metadata (the Test button's request), at
#   the probe path and timeout the save sends, or the stored ones. It waits on
#   SAP up to 40 s, plus 10 s for an OAuth token exchange (the route declares
#   maxDuration = 90). Every save's audit row records rotationProbe:
#   { mode, ran, outcome: passed | rejected | noAnswer | skipped, reason }.
#   observe — never refuses. The save stores what was sent; its response and
#             the Connections form say when SAP refused the new secret
#             ("calls through this connection will fail until it is
#             corrected") or could not check it, and why.
#   enforce — refuses (400, nothing written, the working secret keeps
#             serving) only when SAP refused the sign-in with the new secret
#             (the tenant's 401, or its token endpoint's 400, 401 or 403) while
#             the stored secret is known to work. No answer, a timeout, a
#             5xx, the tenant's 403 or 404, no probe path, or a stored row
#             that will not open all save, as under observe.
#   off     — no probe: the new secret is stored unconditionally.
# An unrecognised value reads as observe. Switch to enforce only as described
# in docs/runbooks/coreedge-governed-pipeline.md.
COREEDGE_ROTATION_PROBE=""

# The Contract Compiler (P1.3): every verify, capture and Studio download that
# parses a tenant's bytes or renders a document runs in a worker thread
# through one fair gate. See docs/runbooks/coreedge-contract-compiler.md,
# "Contract jobs". Both optional.
#   COREEDGE_CONTRACT_ISOLATES             workers at once, per function
#                                          instance; default 1 (Hobby: 2 GB /
#                                          1 vCPU). 0 turns the compiler off:
#                                          every verify is refused before SAP
#                                          is asked (COMPILER_UNAVAILABLE,
#                                          nothing verified, so custom writes
#                                          cannot be unlocked); downloads and
#                                          captures answer 503; /schema is
#                                          unaffected. On Pro: 2, but only
#                                          after the project's default memory
#                                          is Performance (4 GB / 2 vCPU) in
#                                          the dashboard. That setting is
#                                          project-wide (every function, and
#                                          its Provisioned Memory cost);
#                                          vercel.json "memory" is ignored.
#   COREEDGE_CONTRACT_SECONDS_PER_ORG_DAY  each organisation's worker wall time
#                                          per UTC day, across every instance;
#                                          default 40, 0 is unlimited. Pro with
#                                          Spend Management: 120, or 0.
# GET /schema never uses the compiler, whatever these say.
COREEDGE_CONTRACT_ISOLATES=""
COREEDGE_CONTRACT_SECONDS_PER_ORG_DAY=""

# Tenant-scope guard: throw | log | off. Optional; defaults to log in
# production and throw everywhere else.
#
# A query on a tenant-anchored model (Solution, ApiAccessGrant, ConfigAudit,
# ...) with no organizationId in its where. log lets it run, logs it and counts
# it durably in the TenantGuardViolation table; throw refuses it. Switch
# production to throw only after seven days with no TenantGuardViolation row
# seen (the query is in docs/runbooks/coreedge-step-up.md): runtime logs do not
# last that long, and an unscoped path the burn-down missed would become an
# outage.
TENANT_SCOPE_GUARD=""

# Web Push / VAPID (optional — for push notifications)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@abeam.app"

# Cron (required for scheduled jobs in production)
CRON_SECRET=""

# Northbound audit retention, in days. Optional; defaults to 30.
#
# 30 days is the window the operations console can actually query — opsWindowHours
# clamps to 24 * 30 — so a row older than that is invisible to every screen that
# reads the table. The nightly /api/cron/northbound-retention job deletes past it.
# The same period, in the same job, expires the Workbench console's platform-scope
# read rows (PlatformAuditEvent, action SAP_CONSOLE_READ, P0.14b); the Workbench
# write-back's rows on that table are never swept.
#
# REFUSED, NOT CLAMPED, outside 7..3650: a value below the floor is not a shorter
# retention, it is no audit trail, and a misconfigured job deletes nothing rather
# than something. See src/lib/northbound/retention.ts.
NORTHBOUND_AUDIT_RETENTION_DAYS=""

# Upstash Redis (REQUIRED in serverless production for distributed rate limiting)
# Without these, src/lib/security/rate-limit.ts falls back to an in-memory Map which
# resets per function invocation on Vercel — effectively disabling rate limiting.
# Create a free Redis database at https://console.upstash.com/redis and copy the
# REST URL + REST token (not the TCP credentials).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
#
# If Upstash cannot be reached in production every limited route still refuses
# (fails closed, as before), but now answers 503 LIMITER_UNAVAILABLE with
# Retry-After, never 429: nobody was over a limit. See
# docs/runbooks/coreedge-rate-limits.md.

# How the edge limits authenticated machine routes (/api/northbound, and the
# reserved /api/twin, /api/events/ingest, /api/mgmt, /api/outbound, /api/mcp):
# credential | ip. Optional; defaults to credential.
#   credential — each call carrying a bearer counts against THAT credential
#                (a hash of it, 600 a minute), then a per-IP backstop (6,000 a
#                minute). One runaway key no longer throttles every other key
#                behind its address. An address whose calls fail to
#                authenticate more than 60 times a minute is refused at the
#                edge (429 RATE_LIMITED_ADDRESS) until the window frees room,
#                so a flood of made-up keys cannot buy more database lookups
#                than the old per-IP bucket allowed.
#   ip         — the old shared per-IP buckets (300 GET / 120 other a minute).
#                A rollback switch only.
# A machine call with no bearer, and every browser route, keep the per-IP
# buckets in both modes. Anything else reads as credential.
COREEDGE_MACHINE_RATE_LIMIT=""

# Sentry (optional — error tracking). The server config reads SENTRY_DSN; the
# browser config (sentry.client.config.ts) reads NEXT_PUBLIC_SENTRY_DSN — set
# both, or client-side errors are never reported.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Presales guest surface secrets (src/lib/presales/*). Both were read by the
# code and required by scripts/check-production-env.js but undocumented here.
#   PRESALES_CSRF_SECRET      REQUIRED IN PRODUCTION: signs the /c and /a POST
#                             nonces. ≥32 chars, must differ from NEXTAUTH_SECRET.
#                             Dev falls back to NEXTAUTH_SECRET; prod does not.
#   PRESALES_INTERNAL_SECRET  shared secret between /c/sign and the internal
#                             /api/presales/sign-pdf renderer. If unset, a
#                             sign-off completes WITHOUT a PDF — set it.
#   PRESALES_EMAIL_FROM       optional sender override for guest emails.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRESALES_CSRF_SECRET=""
PRESALES_INTERNAL_SECRET=""
PRESALES_EMAIL_FROM=""

# E2E testing + /dev-login UI (the page at /dev-login is a thin wrapper around
# /api/auth/test-login). Set all three to enable internal-team one-click sign-in
# without the magic-link round-trip:
#   ENABLE_TEST_LOGIN_ENDPOINT="true"   — required, opens the API gate
#   E2E_TEST_SECRET="<32 char random>"  — required, the secret testers paste
#   ALLOW_TEST_LOGIN_IN_PROD="true"     — required *only* in production
#   INTERNAL_TEST_DEPLOYMENT="true"     — required *only* in production: the
#     pre-deploy guard (scripts/check-production-env.js) FAILS the build if the
#     test-login flags are set in prod unless you set this to consciously
#     acknowledge "this is an internal test deployment, not customer-facing".
#     Never set it on a deploy that serves real users.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ENABLE_TEST_LOGIN_ENDPOINT=""
E2E_TEST_SECRET=""
ALLOW_TEST_LOGIN_IN_PROD=""
INTERNAL_TEST_DEPLOYMENT=""
# Optional: comma-separated IP allow-list applied to /api/auth/test-login.
# When set, only the listed IPs (resolved from Vercel's trusted, non-spoofable
# header) may use the endpoint even when all gates pass. Recommended in
# production to lock the backdoor to your CI runners.
TEST_LOGIN_ALLOWED_IPS=""
# In production, the backdoors fail CLOSED when their IP allow-list is empty.
# Set this to "true" ONLY for an internal test deployment that cannot pin caller
# IPs and deliberately relies on the shared secret alone.
ALLOW_BACKDOOR_WITHOUT_IP_ALLOWLIST=""

# Dev seed backdoors (/api/dev/seed-presales-test, /api/dev/seed-affirm).
# These mint REAL abeam-sessions and mutate durable data — dev/demo only.
# Each requires its own secret env var to be set (no in-repo fallback); the
# route 404s when unset. In production they 404 unless ALLOW_DEV_SEED_IN_PROD
# is "true" (flagged dangerous by scripts/check-production-env.js — do NOT set
# on the production deploy). Secrets must be >=24 chars in production.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEV_SEED_SECRET=""
DEV_AFFIRM_SEED_SECRET=""
ALLOW_DEV_SEED_IN_PROD=""

# Affirm external executive journey (src/app/(external)/a/*). The token+OTP
# guest surface for the Affirm flow is FAIL-CLOSED: every /a/* page and route
# 404s unless this is exactly "true". Leave unset/absent to keep it off.
# When enabled in production, PRESALES_CSRF_SECRET must be set (the /a CSRF
# nonces reuse it) — enforced by scripts/check-production-env.js.
AFFIRM_EXTERNAL_ENABLED=""

# Neutral Discovery (the /discovery workbench + /d external guest surface).
# Same FAIL-CLOSED pattern as AFFIRM_EXTERNAL_ENABLED: everything 404s unless
# this is exactly "true". It was undocumented here while gating a whole
# surface — discoverable only by reading src/lib/discovery/guards.ts.
NEUTRAL_DISCOVERY_ENABLED=""

# 2608 WS6 — To-Be Process Pack (the /tobe workbench + /a/tobe client view +
# /api/tobe/*). Same FAIL-CLOSED pattern as the two flags above: every page and
# route 404s, and the Workbench hub advertises no card, unless this is exactly
# "true". Read by src/lib/tobe/guards.ts.
# Turning it on shows the surface but not any content: packs are generated per
# engagement from the To-Be rules, so run `pnpm sap:2608:seed-tobe` once against
# the same database to create the TobeRule rows (add --pilot for the
# Order-to-Cash demonstration bundle). Without that seed every generated pack is
# all-standard, which is correct but empty of configuration evidence.
TOBE_PACK_ENABLED=""

# 2608 WS0 — which SAP Best Practices content release the app grounds on.
# "2602" (default when unset) or "2608". Read by src/lib/sap-content/release.ts:
# every SAP-grounded page shows "SAP content release <release> · MY" in its
# footer and every loader resolves its source files from
# scripts/lib/sap-content-sources.ts. Stays 2602 until WS7 flips the default.
SAP_CONTENT_RELEASE=""

# App URL (used for sitemap, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3003"
NEXT_PUBLIC_ENABLE_PWA=false

# Product surface routing (src/middleware.ts).
#   WORKBENCH_ONLY="true"  — single-host mode: this deployment presents ONLY the
#     ABeam Workbench. The root and every Aptus-portal page route redirect to the
#     Workbench home (/workbench); /affirm, /presales, /c/* and /dev-login stay
#     reachable. Use when one host should be the Workbench and nothing else.
#   WORKBENCH_HOST / PORTAL_HOST — the two-host alternative: only active when BOTH
#     are set, it splits the Workbench and the Aptus portal across two hostnames.
#     Leave both unset (and WORKBENCH_ONLY unset) for a combined single-host dev.
WORKBENCH_ONLY=""
WORKBENCH_HOST=""
PORTAL_HOST=""

# BYOAI Encryption (required if using Bring Your Own AI — 64-char hex = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOAI_ENCRYPTION_KEY=""

# SAP connection secrets encryption (required to store per-Organization SAP
# connections — the SapConnection keystone). Seals password/bearer/clientSecret
# at rest with AES-256-GCM. 64-char hex = 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAP_CONNECTION_ENCRYPTION_KEY=""

# SAP host allow-list — EXTRA domain suffixes a SAP connection's base URL (and
# OAuth token URL) may use, comma-separated, e.g. "corp.example.com,sap.acme.net".
# Optional. The built-in list (src/lib/studio/sap-host-allowlist.ts) already
# covers SAP's cloud domains: ondemand.com, cloud.sap, sap.com, ariba.com,
# successfactors.com/.eu and sapsf.com/.eu/.cn (every SuccessFactors API server
# in SAP KBA 2215682). Set this only for on-premise, RISE/Private Edition or
# partner-hosted systems on your own domain. Matching is per DNS label: the
# suffix "corp.example.com" admits "s4.corp.example.com", never
# "evilcorp.example.com". It ADDS to the list; nothing here can switch the
# check off, and IP literals, localhost and internal names stay refused.
SAP_HOST_ALLOWLIST_EXTRA=""

# The same allow-list, for the tenants THIS DEPLOYMENT configures (P0.14b):
# observe | enforce | off. Optional; defaults to observe.
# Every Workbench console call (preview, entities, operations, capabilities,
# the catalogue probes, Probe all, the Ariba explorer, the write-back) to a
# tenant configured through {PREFIX}_BASE_URL / {PREFIX}_TENANTS_JSON (S4_TDD_*,
# SF_TDD_*, S4_PRIVATE_TDD_*, S4_ONPREM_TDD_*, ECC_TDD_*) or ARIBA_* checks its
# base URL and, when the auth type exchanges a token, its OAUTH_TOKEN_URL
# against the list above, exactly as a stored connection is checked on save.
#   observe — a host the list refuses is logged once per process
#             ("[env-tenant-hosts] ... would refuse this call") and recorded on
#             the call's platform audit row (detail.hostCheck "unlisted"); the
#             call goes ahead. Every call that works today keeps working.
#   enforce — such a call is refused 403 HOST_NOT_ALLOWED before anything is
#             sent, the token exchange included, and the refusal is audited.
#             A write-back is recorded BLOCKED.
#   off     — not checked.
# Any other value, a typo included, is observe. Before enforcing, run
# `pnpm coreedge:env-tenant-hosts` with the deployment's variables: it lists
# what enforce would refuse (hosts and variable names only, never a secret).
# Private and on-premise landscapes on a customer domain need that domain in
# SAP_HOST_ALLOWLIST_EXTRA first; an http:// or IP-address tenant cannot pass.
# Runbook: docs/runbooks/coreedge-console-pipeline.md
COREEDGE_ENV_TENANT_HOSTS=""

# Which grants open a console read of a TEST, PROD or undeclared connection
# (wave 2 integration review round 3): observe | enforce. Optional; defaults
# to observe. The console's environment ceiling opens a landscape for an
# organization with ANY live grant for it. A grant whose app is RETIRED (or
# gone), or a legacy unbound grant under COREEDGE_GRANT_BINDING=strict,
# authorises nothing at the broker, the lane board or discovery.
#   observe — such a grant still opens the console; each read it alone opens
#             is logged ("[console-grants] ... would refuse it") and recorded
#             on its platform audit row (detail.ceilingWouldRefuse). Every
#             console read that works today keeps working.
#   enforce — such a grant does not count: with no other live grant for the
#             environment the read is refused 403 NO_APPROVED_GRANT.
# Any other value, a typo included, is observe. Review the observed rows
# before enforcing. Runbook: docs/runbooks/coreedge-console-pipeline.md
COREEDGE_CONSOLE_GRANTS=""

# The SAP API Policy §1.2 sign-off (P1.2). On S/4HANA Cloud Public Edition an
# interface registered by its own service path, or naming a Z*, Y* or YY1_*
# service, needs a builder other than its registrant to record why calling it
# is allowed (Studio, Interfaces).
#   observe — the default. Nothing is refused: an approval without a sign-off
#             is noted on its ConfigAudit DECISION row (policySignOffMissing),
#             and a call through such an interface is logged ([api-policy]).
#   enforce — the approval is refused, and the northbound read and write answer
#             403 API_POLICY_SIGN_OFF_REQUIRED.
#   off     — no check at all.
# Any other value, a typo included, is observe. Seven clean days in observe
# before enforcing. Runbook: docs/runbooks/coreedge-api-policy.md
COREEDGE_API_POLICY_SIGNOFF=""

# Envelope encryption with versioned, rotatable master keys (P0.10). OPTIONAL,
# and OFF unless SAP_CONNECTION_ENCRYPTION_ACTIVE_KEY is set: with only the key
# above, secrets are sealed exactly as before (that key is the implicit "v1").
#   SAP_CONNECTION_ENCRYPTION_KEYS        "v1:<64 hex>,v2:<64 hex>" — every master
#     key that may still be needed to unwrap a data key. The legacy key above,
#     if set, is v1 and must equal any v1 entry here.
#   SAP_CONNECTION_ENCRYPTION_ACTIVE_KEY  the version new org data keys are
#     wrapped under, e.g. "v2". Setting it switches new writes to the "ce2"
#     format. To roll back to pre-P0.10 code: FIRST unset this (and any KMS
#     provider below, and SAP_CONNECTION_ACCEPT_LEGACY_FORMAT=none) and
#     redeploy, so nothing new is written as ce2; SAP_CONNECTION_ENCRYPTION_KEY
#     ITSELF must be set, because pre-P0.10 code never reads the ring. Then
#     `pnpm keys:reseal --to legacy --apply` (refused while this is set, or
#     while the legacy variable is unset) and
#     `pnpm keys:verify --expect-format=legacy`. Rotation, reseal, verify,
#     retire and the restore drill: docs/coreedge/SAP-CONNECTION-KEYSTONE-RUNBOOK.md.
#   SAP_CONNECTION_KEY_PROVIDER           "env" (default). A cloud KMS adapter
#     shipped in key-provider.ts's built-in list is selected here by its exact
#     (lowercase) name; the deploy gate fails any other value.
#   SAP_CONNECTION_ACCEPT_LEGACY_FORMAT   which legacy-format (pre-envelope)
#     secrets still open: "any" (default, as before), "bound" (only those bound
#     to their own row) or "none". Set "none" once `pnpm keys:verify
#     --expect-format=ce2` passes, so an old pre-AAD blob written over a row
#     cannot be opened there while v1 stays configured for a rollback. "none"
#     needs the active key above set; the deploy gate fails it otherwise.
SAP_CONNECTION_ENCRYPTION_KEYS=""
SAP_CONNECTION_ENCRYPTION_ACTIVE_KEY=""
SAP_CONNECTION_KEY_PROVIDER=""
SAP_CONNECTION_ACCEPT_LEGACY_FORMAT=""

# AI provider keys — used by /lib/intelligence/* when BYOAI is not configured per-org.
# DEFAULT_AI_PROVIDER selects between "anthropic" and "openai" (default: anthropic).
# OPENAI_MODEL overrides the OpenAI model id (default depends on provider code).
DEFAULT_AI_PROVIDER=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL=""

# SAP Business Accelerator Hub grounding — the classifier cites cached Hub API
# coverage (the SapApiReference table, see docs/runbooks/sap-catalog-ingest.md)
# as evidence. ON BY DEFAULT: leave unset to keep it on. The ONLY value that
# turns it off is the literal "0" (src/lib/classification/api-evidence.ts).
# It reads the local table, not api.sap.com, and does not need S4_TDD_*.
ENABLE_API_HUB_GROUNDING=""

# SAP API lifecycle on deploy (P0.8). vercel-build stamps SAP's Hub state,
# version and SAP-named successor onto the API catalogue rows that already
# exist, from the COMMITTED snapshot sap-references/api-hub-catalog.json (no
# network). Existing rows and lifecycle columns only; idempotent; never reverts
# a fresher stamp or replaces a recorded successor; a failure is logged and does
# not fail the deploy. "apply" (default; also when unset) or "off" to skip.
# Runbook: docs/runbooks/coreedge-catalogue-addresses.md.
HUB_LIFECYCLE_ON_DEPLOY=""

# Simulation bridge (/api/auth/verify-izzat) — internal demo backdoor. Issues a
# real session for SIMULATION_BRIDGE_EMAIL when ENABLE_SIMULATION_BRIDGE=true
# AND a request body matches SIMULATION_BRIDGE_SECRET (timing-safe compared).
# MUST stay disabled in production unless explicitly demoing.
ENABLE_SIMULATION_BRIDGE=""
# Production kill-switch override (src/app/api/auth/verify-izzat/route.ts) —
# flagged fatal by scripts/check-production-env.js. Never set on a real deploy.
ALLOW_SIMULATION_BRIDGE_IN_PROD=""
SIMULATION_BRIDGE_SECRET=""
SIMULATION_BRIDGE_EMAIL=""
SIMULATION_BRIDGE_ASSESSMENT=""
# Optional: comma-separated IP allow-list applied to /api/auth/verify-izzat.
SIMULATION_BRIDGE_ALLOWED_IPS=""

# Security & Access Control
AUTH_INVITATION_ONLY=false
AUTH_ALLOWED_DOMAINS=abeam.com,aptus.dev
AUTH_WHITELIST_BYPASS=true

# Developer workspace sign-up (roadmap P0.13): off | open. Optional; defaults to off.
#   off  — sign-up and magic-link sign-in admit exactly who the AUTH_* settings
#          above admit, and create what they always created. Any value other
#          than "open" (a typo included) is off.
#   open — a NEW person whose address passes COREEDGE_DEVELOPER_SIGNUP_DOMAINS
#          (comma-separated; empty = any domain), or the AUTH_* policy, gets
#          their own organization as sandbox_developer when they click their
#          first sign-in link (from /signup/developer or the sign-in page):
#          Discover, the catalogue and SANDBOX tenants only, inviting
#          colleagues, no governance rights. Nothing is written before the
#          link is clicked. Limited to 10 sign-ups an hour per caller address
#          (via /signup/developer or the sign-in page alike) and 5 per email
#          address; a workspace sends at most 10 invitations a day, revoked
#          ones included. Existing accounts are untouched. (Off, the partner
#          trial at /signup keeps the shared sign-in bucket per caller address;
#          only the 5-an-hour per-email limit applies to it in both modes.)
# Declare the SAP API Hub sandbox as a SANDBOX deployment tenant
# (S4_TDD_TENANTS_JSON, "environment":"SANDBOX") or developers have nothing to
# read. See docs/runbooks/developer-onboarding.md.
COREEDGE_DEVELOPER_SIGNUP=""
COREEDGE_DEVELOPER_SIGNUP_DOMAINS=""

# First platform admin of a NEW instance (roadmap P0.13). Optional; unset by default.
# Nobody becomes platform admin by signing in first. On an instance with no
# active platform admin, a signed-in person presents this token at
# /coreedge/bootstrap to become one. At least 32 characters (shorter counts as
# unset), compared in constant time, single use (its SHA-256 is recorded on the
# claim's PlatformGovernanceAudit row) and every attempt is audited. An
# instance that already has an admin refuses it whatever it is. Unset it after
# the claim; to recover an instance with no admin left, configure a NEW token.
COREEDGE_BOOTSTRAP_TOKEN=""

# SAP S/4HANA Cloud Public Edition TDD API integration (read-only)
# Usage: pnpm sap:tdd:smoke
S4_TDD_BASE_URL=""
S4_TDD_TENANT_LABEL=""
S4_TDD_TENANTS_JSON=""
S4_TDD_AUTH_TYPE="basic"
S4_TDD_USERNAME=""
S4_TDD_PASSWORD=""
S4_TDD_BEARER_TOKEN=""
S4_TDD_OAUTH_TOKEN_URL=""
S4_TDD_CLIENT_ID=""
S4_TDD_CLIENT_SECRET=""
S4_TDD_API_PATH="/sap/opu/odata/sap/API_BUSINESS_PARTNER/A_BusinessPartner?$top=1&$format=json"
S4_TDD_TIMEOUT_MS=15000
S4_TDD_PROBE_CONCURRENCY=4
# In development this defaults to public unless set to false.
# In production it is private unless explicitly set to true.
S4_TDD_PUBLIC_ACCESS=false
# Workbench write-back (Write Mode on /sap-explorer, and the hub-content
# write-test): creates records in the tenant above. Off unless exactly "true",
# and refused unless S4_TDD_WRITE_SECRET is set. Every write is recorded,
# naming the person, BEFORE SAP is called (PlatformAuditEvent); if that record
# cannot be written the write is not sent (503). There is no setting to turn
# the audit off. Unset this in production to switch write-back off.
# Runbook: docs/runbooks/sap-workbench-write-back.md
S4_TDD_WRITE_ENABLED=false
S4_TDD_WRITE_SECRET=""
# 2608 (WS4): the Purchase Orders service is OData V4 CE_PURCHASEORDER_0001
# (SAP_COM_0053). SAP deprecated API_PURCHASEORDER_PROCESS_SRV (V2). Set this
# to "true" to keep the V2 service for ONE release (until 2702) on a tenant
# whose arrangement does not expose the V4 service yet. Default off.
S4_TDD_PO_ODATA_V2=false

# SuccessFactors TDD — same OData explorer, second product. Uses the SF_TDD_*
# prefix (identical shape to S4_TDD_*). SuccessFactors OData V2 lives under a
# single service root (/odata/v2); set the tenant baseUrl to your data
# centre's API server from SAP KBA 2215682, e.g. https://api17.sapsf.com or
# https://api55.sapsf.eu (older ones: https://apiXX.successfactors.com).
# Surfaces on /sap-explorer once a tenant is set.
#
# AUTH: SAP RETIRES HTTP BASIC FOR SUCCESSFACTORS APIS ON 20 NOVEMBER 2026
# (unsupported, and unavailable for new configurations) and deletes it on a
# TENTATIVE 12 November 2027, when calls start failing.
# Use SF_TDD_AUTH_TYPE="oauth-saml-bearer" — the OAuth 2.0 SAML bearer
# assertion grant — for any tenant that must keep working past that date:
#   SF_TDD_OAUTH_TOKEN_URL  https://apiXX.successfactors.com/oauth/token
#   SF_TDD_CLIENT_ID        the API key from Admin Center → Manage OAuth2 Client Applications
#   SF_TDD_COMPANY_ID       the SuccessFactors company id
# then EITHER (recommended — the app signs a fresh assertion per token request):
#   SF_TDD_SAML_PRIVATE_KEY the RSA private key generated when the API key was
#                           registered (Generate X.509 Certificate). PEM or
#                           headerless base64; "\n" escapes are decoded.
#   SF_TDD_SAML_USER_ID     the SuccessFactors user the token is issued for
# OR (fallback — stops working when the assertion expires, 10 min by SAP's default):
#   SF_TDD_SAML_ASSERTION   a pre-signed assertion from your IdP or SAP's
#                           offline generator (base64, multi-KB)
# "basic" (username "sfapiuser@companyId") still works until the deletion date
# and is kept only for tenants that have not migrated yet. Studio saves a NEW
# SuccessFactors Basic connection with a dated warning; it never refuses one,
# and existing connections are untouched.
#
# SF_BASIC_AUTH_DELETION_DATE — SAP's current deletion date for SuccessFactors
# Basic, YYYY-MM-DD. Leave blank for SAP's published 2027-11-12. Set it only
# when SAP moves the date (KBA 3146449); from this date every Basic
# SuccessFactors call is refused with migration instructions. An unparseable
# value is ignored, never obeyed.
SF_BASIC_AUTH_DELETION_DATE=""
SF_TDD_TENANTS_JSON=""
# …or a single tenant:
SF_TDD_BASE_URL=""
SF_TDD_TENANT_LABEL=""
SF_TDD_AUTH_TYPE="oauth-saml-bearer"
SF_TDD_USERNAME=""
SF_TDD_PASSWORD=""
SF_TDD_BEARER_TOKEN=""
SF_TDD_OAUTH_TOKEN_URL=""
SF_TDD_CLIENT_ID=""
SF_TDD_CLIENT_SECRET=""
SF_TDD_COMPANY_ID=""
SF_TDD_SAML_PRIVATE_KEY=""
SF_TDD_SAML_USER_ID=""
SF_TDD_SAML_ASSERTION=""

# Other OData products on /sap-explorer and in Studio use the SAME variable
# shape under their own prefix (src/lib/sap-public/tdd-connector.ts
# SAP_ODATA_PRODUCTS): S4_PRIVATE_TDD_* (SAP Cloud ERP Private / RISE),
# S4_ONPREM_TDD_* (S/4HANA on-premise) and ECC_TDD_* (SAP ERP). Two extra
# variables apply to landscapes that address an SAP client:
#   {PREFIX}_TENANT_ENVIRONMENT  DEV | TEST | PROD (or the landscape's own name)
#   {PREFIX}_TENANT_CLIENT       three digits, e.g. 100 — appended as ?sap-client=
# or, in {PREFIX}_TENANTS_JSON, per tenant: {"key","label","baseUrl","environment","client"}.
# These systems are usually not internet-reachable from Vercel; a connection can
# be configured, and the connection test reports TIMEOUT/ERROR honestly if not.
SF_TDD_TIMEOUT_MS=15000
SF_TDD_PROBE_CONCURRENCY=4
SF_TDD_PUBLIC_ACCESS=false
SF_TDD_WRITE_ENABLED=false
SF_TDD_WRITE_SECRET=""

# SAP Ariba TDD — REST/OAuth2, NOT OData (third product on /sap-explorer).
# Ariba uses a 2-legged OAuth2 client-credentials token plus an apiKey header
# and a realm-scoped `realm` query param. Configured when BASE_URL + API_KEY +
# OAUTH_TOKEN_URL + CLIENT_ID + CLIENT_SECRET are all set. Endpoint catalog is
# code-side (src/lib/sap-public/ariba-connector.ts) — edit paths per your realm.
# BASE_URL and OAUTH_TOKEN_URL must be absolute http(s) URLs, scheme included;
# otherwise the explorer shows the error and /api/sap/ariba/call refuses every
# call (400) before any token exchange (roadmap P0.6).
ARIBA_BASE_URL=""                 # e.g. https://openapi.ariba.com
ARIBA_API_KEY=""                  # application key from the Ariba developer portal
ARIBA_OAUTH_TOKEN_URL=""          # e.g. https://api.ariba.com/v2/oauth/token
ARIBA_CLIENT_ID=""                # OAuth client id (application OAuth secret)
ARIBA_CLIENT_SECRET=""            # OAuth client secret
ARIBA_OAUTH_GRANT_TYPE="client_credentials"
# One realm…
ARIBA_REALM=""
ARIBA_REALM_LABEL=""
# …or several: [{"key":"myrealm-T","label":"Test realm"}]
# When ARIBA_REALMS_JSON is set it wins over ARIBA_REALM. If it is not a JSON
# array of objects, each with a key or a label, the explorer shows the error
# and /api/sap/ariba/call refuses every call (400) before any token exchange
# (roadmap P0.6). An empty list, "[]", is malformed too: leave this empty ("")
# to use ARIBA_REALM.
ARIBA_REALMS_JSON=""
# enforce (default): once realms are configured, a call must name one of them;
# any other realm, or none, is refused with 400. off: the old pass-through, for
# a caller that relied on naming other realms. A malformed ARIBA_REALMS_JSON is
# refused either way. Runbook: docs/runbooks/sap-ariba-explorer.md
ARIBA_REALM_ALLOWLIST=enforce
# true: call the deprecated v1 sourcing paths (Event Management, Sourcing
# Project Management) instead of v2, for one release. The explorer shows the v1
# path, marked as pinned.
ARIBA_SOURCING_V1=false
ARIBA_TIMEOUT_MS=30000
ARIBA_PUBLIC_ACCESS=false

# ── Harvested Hub artifacts → a deployed instance ────────────────────────────
# The 7,147 individual artifacts under sap-references/hub-harvest/ (integrations,
# BAdIs, scenarios, events, BO interfaces) are NOT bundled — a static import
# would bake 2.4MB into every serverless function. The admin "Import harvested
# artifacts" control fetches them at request time from the commit THIS deployment
# was built from, in chunks.
#
# ON VERCEL, SET NOTHING. VERCEL_GIT_REPO_OWNER / _SLUG / _COMMIT_SHA are
# supplied by the platform and are what the import uses.
#
# Elsewhere, both of these are required, and the ref must be a FULL 40-character
# SHA. A branch is refused on purpose: rows fetched from a moving ref could come
# from code the running instance has never seen, and the catalogue would look
# identical either way.
HUB_HARVEST_REPO=""
HUB_HARVEST_REF=""

# ── Release tooling: an operator's machine only (P0.17) ──────────────────────
# Read by `pnpm release:post-deploy-check` and the migration backout tooling
# (docs/runbooks/coreedge-release.md). NOT application settings: never set them
# in Vercel, and never commit a value. The app reads none of them, so leaving
# them unset changes nothing for any user. Every one of these tools keeps keys
# and URLs out of what it prints.
#
# The deployment to check, origin only (https; http only for localhost).
# COREEDGE_CHECK_BASE_URL="https://ab-workbench.vercel.app"
# The release canary app's runtime key (ce_...), and its two interfaces: one
# SAP-standard (catalogue) read and one Z* or YY1_* (customer-built) read.
# COREEDGE_CHECK_KEY=""
# COREEDGE_CHECK_STANDARD_INTERFACE=""
# COREEDGE_CHECK_CUSTOM_INTERFACE=""
# A read-only URL of the SAME database the deployment uses, to find each call's
# audit row by correlation id (SELECT on "NorthboundAuditEvent" is enough).
# COREEDGE_CHECK_AUDIT_DATABASE_URL=""
# Optional: the Z* interface's key when it is another app's; an interface of
# the canary with no grant (expects 403 FORBIDDEN; without it an unknown id is
# called and 404 NOT_FOUND expected); the commit that must be serving; the
# Vercel Deployment Protection bypass secret, for checking a protected preview.
# COREEDGE_CHECK_CUSTOM_KEY=""
# COREEDGE_CHECK_REFUSED_INTERFACE=""
# COREEDGE_CHECK_EXPECT_COMMIT=""
# COREEDGE_CHECK_PROTECTION_BYPASS=""
#
# `pnpm migrations:rehearse-backout` backs out and re-applies every migration
# under the protocol on REHEARSAL_DATABASE_URL (DESTRUCTIVE to that database;
# a non-local host needs --allow-remote, which is for the preview database
# only, never production), using SHADOW_DATABASE_URL, an empty scratch one.
# REHEARSAL_DATABASE_URL=""
# SHADOW_DATABASE_URL=""
#
# `pnpm migrations:backout-apply <name>` backs one migration out of the one
# database at BACKOUT_DATABASE_URL (direct, unpooled), after the operator types
# its name back. It sets DATABASE_URL and DIRECT_DATABASE_URL to it for the
# prisma CLI: a bare `DATABASE_URL=... prisma db execute --schema
# prisma/schema.prisma` would run on DIRECT_DATABASE_URL's database instead
# (schema.prisma's directUrl), such as the local one this file sets above.
# BACKOUT_DATABASE_URL=""
