# Vercel-upload exclusions.
#
# READ THIS BEFORE ADDING A PATTERN: keep every pattern root-anchored (leading
# "/"). These are gitignore-style globs, so an unanchored pattern matches at ANY
# depth and matches DIRECTORIES as well as files. That is not theoretical:
#
#   - "coverage/" also matched src/app/(workbench)/discovery/coverage/,
#     silently stripping that route from the upload so it 404'd in production
#     while building fine locally (.vercelignore is Vercel-upload-only).
#   - "*.csv" also matched src/app/api/presales/bundles/[bundleId]/audit.csv/,
#     which is a route DIRECTORY, not a data file. The consultant audit export
#     link rendered fine and 404'd on click, in production only.
#
# Anchoring is what makes the pattern mean the thing you meant.

# The authenticated developer-guide route reads this one document at runtime.
# Exclude the children, not the parent directory, so the exception can apply.
/docs/*
!/docs/coreedge-developer-guide.md
# The parity scorecard (P1.9): /control-tower/parity imports the committed
# JSON, and vercel-build re-checks it against the simulator, which reads the
# matrix and the registry. A file inside an excluded directory cannot be
# re-included, so the directory comes back first and its other children go
# again, the same shape as the rule above one level down. The exception has no
# trailing slash on purpose: Vercel's upload walker tests a directory as
# "docs/coreedge", which "!/docs/coreedge/" does not match, and it never
# descends into a directory it ignores.
!/docs/coreedge
/docs/coreedge/*
!/docs/coreedge/parity-scorecard.json
!/docs/coreedge/gap-matrix.json
!/docs/coreedge/capability-registry.json
# Other documentation & specs are not needed at runtime.
/specs/
/fit-portal-transfer/

# Reports and audit artifacts
/logs/
/*.csv

# Test infrastructure
/tests/
/playwright.config.ts
/playwright.visual.config.ts
/playwright.visual-app.config.ts
/vitest.config.ts
/test-results/
/coverage/
/playwright-report/

# Large binaries that should never ship
/*.zip
/*.tar.gz
/*.docx
/*.psd
/*.ai
/*.mov
/*.mp4
