{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchPackageNames": ["next", "react", "react-dom", "eslint-config-next"],
      "groupName": "react and next"
    },
    {
      "matchPackagePatterns": ["^@radix-ui/", "^radix-ui"],
      "groupName": "radix-ui"
    },
    {
      "matchPackageNames": ["prisma", "@prisma/client"],
      "groupName": "prisma"
    },
    {
      "matchPackagePatterns": ["^@playwright/", "^playwright"],
      "groupName": "playwright"
    },
    {
      "matchPackagePatterns": ["^@tanstack/"],
      "groupName": "tanstack"
    },
    {
      "matchPackagePatterns": ["^@sentry/"],
      "groupName": "sentry"
    },
    {
      "matchPackagePatterns": ["^@simplewebauthn/"],
      "groupName": "webauthn"
    },
    {
      "matchPackagePatterns": ["^@testing-library/"],
      "groupName": "testing-library"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependency-major"]
    }
  ],
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "timezone": "UTC"
}
