{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchPackageNames": ["next", "react", "react-dom"],
      "groupName": "react and next"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "timezone": "UTC"
}